<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   <record id="email_template_cost_estimate_approved" model="mail.template">
    <field name="name">Cost Estimate Approved</field>
    <field name="model_id" ref="model_project_cost_estimate"/>
    <field name="subject">Cost Estimate Approved: {{ object.name }}</field>

    <field name="email_from">{{ user.email or '' }}</field>

    <field name="body_html" type="html">
        <div>
            <p>
                Your cost estimate
                <strong><t t-out="object.name"/></strong>
                has been <strong>approved</strong>.
            </p>
        </div>
    </field>
</record>

   <record id="email_template_cost_estimate_declined" model="mail.template">
    <field name="name">Cost Estimate Declined</field>
    <field name="model_id" ref="model_project_cost_estimate"/>
    <field name="subject">Cost Estimate Declined: {{ object.name }}</field>

    <field name="email_from">{{ user.email or '' }}</field>

    <field name="body_html" type="html">
        <div>
            <p>
                Your cost estimate
                <strong><t t-out="object.name"/></strong>
                has been <strong>declined</strong>.
            </p>
        </div>
    </field>
</record>
</odoo>