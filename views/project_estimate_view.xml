<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_estimate_list" model="ir.ui.view">
        <field name="name">project.cost.estimate.list</field>
        <field name="model">project.cost.estimate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="estimated_total_cost"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <record id="project_estimate_form" model="ir.ui.view">
        <field name="name">project.cost.estimate.form</field>
        <field name="model">project.cost.estimate</field>

        <field name="arch" type="xml">
            <form string="Cost Estimate">

                <header>
                    <button
                            name="state_action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="status != 'draft'"
                            groups="project_cost.manager"
                    />


                    <button
                            name="state_action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="status != 'submitted'"
                            groups="project_cost.owner"
                    />

                    <button
                            name="state_action_declined"
                            type="object"
                            string="Decline"
                            invisible="status != 'submitted'"
                            groups="project_cost.owner"
                    />
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,declined"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="status != 'draft'"/>
                        <field name="project_id" readonly="status != 'draft'"/>
                    </group>


                    <group string="Cost Breakdown">

                        <field name="breakdown_ids" readonly="status != 'draft'">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="unit_cost"/>
                                <field name="subtotal"/>
                            </list>
                        </field>

                    </group>


                    <group>
                        <field name="estimated_total_cost" readonly="1"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>
     <record id="project_estimate_kanban" model="ir.ui.view">
        <field name="name">project.cost.estimate.kanban</field>
        <field name="model">project.cost.estimate</field>
        <field name="arch" type="xml">

            <kanban>
                <field name="name"/>
                <field name="project_id"/>
                <field name="estimated_total_cost"/>
                <field name="status"/>

                <templates>
                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <div class="fw-bold fs-5">
                                <field name="name"/>
                            </div>

                            <div class="mt-2">
                                <strong>Project:</strong>
                                <field name="project_id"/>
                            </div>

                            <div class="mt-2">
                                <strong>Estimated Cost:</strong>
                                <field name="estimated_total_cost"/>
                            </div>

                            <div class="mt-2">
                                <strong>Status:</strong>
                                <field name="status"/>
                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>

        </field>
    </record>



    <record id="project_estimate_action" model="ir.actions.act_window">
        <field name="name">Project Cost Estimates</field>
        <field name="res_model">project.cost.estimate</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>