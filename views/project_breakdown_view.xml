<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Breakdown List View -->
    <record id="project_breakdown_list" model="ir.ui.view">
        <field name="name">project.cost.breakdown.list</field>
        <field name="model">project.cost.breakdown</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="subtotal"/>
                <field name="estimate_id"/>
            </list>
        </field>
    </record>

    <!-- Breakdown Form View -->
    <record id="project_breakdown_form" model="ir.ui.view">
        <field name="name">project.cost.breakdown.form</field>
        <field name="model">project.cost.breakdown</field>
        <field name="arch" type="xml">
            <form string="Cost Breakdown">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="unit_cost"/>
                        <field name="subtotal"/>
                        <field name="estimate_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
<record id="project_breakdown_action" model="ir.actions.act_window">
    <field name="name">Cost Breakdowns</field>
    <field name="res_model">project.cost.breakdown</field>
    <field name="view_mode">list,form</field>
</record>

</odoo>